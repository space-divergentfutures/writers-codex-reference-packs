{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/space-divergentfutures/writers-codex-reference-packs/pack.schema.json",
  "title": "Writer's Codex Reference Pack (schema v2)",
  "type": "object",
  "required": ["packVersion", "schemaVersion", "lastUpdated", "collections", "entries"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "packVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "schemaVersion": { "const": 2 },
    "lastUpdated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "minAppVersion": { "type": "string" },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "labelSingular", "badge", "schema", "badgeBg", "badgeFg"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "labelSingular": { "type": "string", "minLength": 1 },
          "badge": { "type": "string", "minLength": 1 },
          "schema": {
            "enum": ["example_cards", "principle_cards", "author_cards", "work_cards", "checklist_cards"]
          },
          "badgeBg": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "badgeFg": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        },
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "category", "name", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "work": { "type": "string" },
                "medium": { "type": "string" },
                "year": { "type": "string" },
                "quality": { "enum": ["excellent", "strong", "weak", "terrible"] },
                "text": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "principle": { "type": "string" },
          "example": { "type": "string" },
          "application": { "type": "string" },
          "meta": { "type": "string" },
          "knownFor": { "type": "string" },
          "signature": { "type": "string" },
          "works": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "year": { "type": "string" },
                "note": { "type": "string" },
                "start": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "author": { "type": "string" },
          "year": { "type": "string" },
          "awards": { "type": "string" },
          "text": { "type": "string" },
          "medium": {
            "enum": ["novel", "film", "tv", "comic", "manga", "graphic-novel", "game", "audio", "nonfiction"]
          },
          "items": { "type": "array", "items": { "type": "string" } },
          "_label": { "type": "string" },
          "_badge": { "type": "string" },
          "_bg": { "type": "string" },
          "_fg": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
